FROM php:8.4.26-apache-bookworm

RUN printf '%s\n' \
      'memory_limit=16M' \
      'post_max_size=8M' \
      'upload_max_filesize=8M' \
      'session.upload_progress.enabled=1' \
      'session.upload_progress.min_freq=1' \
      > /usr/local/etc/php/conf.d/zz-local-oom-trigger.ini \
    && printf '%s\n' \
      '<?php header("Content-Type: text/plain"); echo "PHP_READY ", PHP_VERSION, " ", PHP_SAPI, "\n";' \
      > /var/www/html/index.php
